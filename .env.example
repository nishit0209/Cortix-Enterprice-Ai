# ---------------------------------------------------------------------------
# NEXORA Enterprise AI — environment configuration
# Copy to .env (git-ignored). Values below are for LOCAL DEVELOPMENT ONLY.
# Local runtime needs only PostgreSQL. (Docker/compose deployment is documented separately, later.)
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=nexora.settings.dev
SECRET_KEY=dev-insecure-change-me-0123456789abcdef
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080
# Base URL used in emailed links (invitations)
FRONTEND_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL — the ONLY required service (plain local install, no Docker).
# Run once:  $env:PGPASSWORD="<postgres superuser pw>"; .venv\Scripts\python.exe scripts\bootstrap_local_db.py
# It creates roles + nexora_app / nexora_wh and REWRITES the lines below with strong generated passwords.
# ---------------------------------------------------------------------------
NEXORA_APP_PASSWORD=nexora_app_dev
NEXORA_MIGRATOR_PASSWORD=nexora_migrator_dev
NEXORA_OPS_PASSWORD=nexora_ops_dev
WH_LOADER_PASSWORD=wh_loader_dev
WH_EXECUTOR_PASSWORD=wh_loader_dev
DATABASE_URL_APP=postgres://nexora_app:nexora_app_dev@localhost:5432/nexora_app
DATABASE_URL_MIGRATOR=postgres://nexora_migrator:nexora_migrator_dev@localhost:5432/nexora_app
DATABASE_URL_OPS=postgres://nexora_ops:nexora_ops_dev@localhost:5432/nexora_app
WH_DATABASE_URL_LOADER=postgres://wh_loader:wh_loader_dev@localhost:5432/nexora_wh
WH_DATABASE_URL_EXECUTOR=postgres://wh_executor:wh_loader_dev@localhost:5432/nexora_wh
# Use migrator credentials for manage.py migrate: DJANGO_DB_ROLE=migrator
DJANGO_DB_ROLE=app
# pgvector | array | auto  (bootstrap sets this; "array" works on PostgreSQL without pgvector)
VECTOR_BACKEND=auto

# ---------------------------------------------------------------------------
# OPTIONAL services. Leave empty for the local PostgreSQL-only runtime:
#   no REDIS_URL   -> DB cache table, DB job events, in-process background task threads, in-process scheduler
#   no S3 endpoint -> files stored under LOCAL_STORAGE_DIR (default <repo>/var/storage)
# ---------------------------------------------------------------------------
REDIS_URL=
# thread (local) | celery (needs REDIS_URL + worker processes) | eager (inline)
TASK_RUNNER=thread
TASK_RUNNER_THREADS=4
LOCAL_STORAGE_DIR=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nexora
S3_REGION=us-east-1

# Email (optional; without an SMTP server invitation links are also shown in the UI / server log)
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Nexora <no-reply@nexora.local>

# Credential encryption (base64 32 bytes). Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
NEXORA_KEK=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMi1ieXRlcyE=
API_KEY_PEPPER=dev-pepper-change-me

# Google Gemini — the ONLY external generative AI provider.
# Put your key in .env (never commit). Without a key, AI features degrade gracefully.
GEMINI_API_KEY=
GEMINI_TIER=free
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_REASONING=gemini-3.8-flash
GEMINI_MODEL_VISION=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=2048
# Only for GEMINI_TIER=vertex (still Gemini)
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=us-central1
GEMINI_REQUEST_TIMEOUT_S=60
AI_CONSENT_TEXT_VERSION=2026-11-v1
DEV_AGENT_RPD=40

# Local embeddings (no data leaves the server)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
# Hugging Face cache for local embedding models (optional)
# HF_HOME=D:/hf-cache

# Dataset ingestion limits
DATASET_MAX_COLUMNS=1000
DATASET_MAX_ROWS=50000000
MAX_UPLOAD_BYTES=209715200
NEXT_PUBLIC_MAX_UPLOAD_MB=200

# Frontend server-side proxy target (Next rewrites /api/* here)
API_INTERNAL_URL=http://localhost:8000

# Dev-only: allow connectors to private/loopback hosts (SSRF guard bypass for local testing)
ALLOW_PRIVATE_DB_HOSTS=true

# ML workspace (CPU training limits)
ML_MAX_TRAIN_ROWS=500000
ML_MAX_TRAIN_SECONDS=900

# Connectors / pipelines
CONNECTOR_CONNECT_TIMEOUT_S=10
CONNECTOR_STATEMENT_TIMEOUT_S=30
# Extra denied CIDRs for external DB hosts (comma-separated; recommended in production)
CONNECTOR_DENY_CIDRS=
PIPELINE_MAX_ROWS=50000000
PIPELINE_HEARTBEAT_TIMEOUT_S=900
PIPELINE_MIN_SCHEDULE_INTERVAL_S=300

# Document Intelligence (OCR uses the Tesseract binary if installed: eng + hin + guj language packs)
DOCUMENT_MAX_UPLOAD_BYTES=52428800
DOCUMENT_MAX_PAGES=500

# Local embeddings model cache / download (run `manage.py download_models` once, ~1.1 GB)
EMBEDDING_CACHE_DIR=
EMBEDDING_AUTO_DOWNLOAD=true
# Without pgvector (VECTOR_BACKEND=array): max candidate vectors ranked per search
DOCUMENT_VECTOR_MAX_SCAN=20000
