# ---------------------------------------------------------------------------
# NEXORA Enterprise AI — environment configuration
# Copy to .env (git-ignored). Values below are for LOCAL DEVELOPMENT ONLY.
# Host-side tools (pytest, manage.py) use these; docker-compose overrides hosts.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=nexora.settings.dev
SECRET_KEY=dev-insecure-change-me-0123456789abcdef
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080

# Postgres (container exposed on host port 5433; local PG17 keeps 5432)
POSTGRES_SUPERUSER_PASSWORD=nexora_super_dev
NEXORA_APP_PASSWORD=nexora_app_dev
NEXORA_MIGRATOR_PASSWORD=nexora_migrator_dev
NEXORA_OPS_PASSWORD=nexora_ops_dev
WH_LOADER_PASSWORD=wh_loader_dev
DATABASE_URL_APP=postgres://nexora_app:nexora_app_dev@localhost:5433/nexora_app
DATABASE_URL_MIGRATOR=postgres://nexora_migrator:nexora_migrator_dev@localhost:5433/nexora_app
DATABASE_URL_OPS=postgres://nexora_ops:nexora_ops_dev@localhost:5433/nexora_app
WH_DATABASE_URL_LOADER=postgres://wh_loader:wh_loader_dev@localhost:5433/nexora_wh
WH_DATABASE_URL_EXECUTOR=postgres://wh_executor:wh_loader_dev@localhost:5433/nexora_wh
# Use migrator credentials for manage.py migrate: DJANGO_DB_ROLE=migrator
DJANGO_DB_ROLE=app

# Redis / Celery
REDIS_URL=redis://localhost:6380/0
CELERY_TASK_ALWAYS_EAGER=false

# MinIO (S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=nexora
S3_SECRET_KEY=nexora_minio_dev
S3_BUCKET=nexora
S3_REGION=us-east-1

# Email (Mailpit in dev: UI http://localhost:8025)
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Nexora <no-reply@nexora.local>

# Credential encryption (base64 32 bytes). Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
NEXORA_KEK=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMi1ieXRlcyE=
API_KEY_PEPPER=dev-pepper-change-me

# Google Gemini — the ONLY external generative AI provider.
# Put your key in .env (never commit). Without a key, AI features degrade gracefully.
GEMINI_API_KEY=
GEMINI_TIER=free
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_REASONING=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_S=60
AI_CONSENT_TEXT_VERSION=2026-11-v1
DEV_AGENT_RPD=40

# Local embeddings (no data leaves the server)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# Dev-only: allow connectors to private/loopback hosts (SSRF guard bypass for local testing)
ALLOW_PRIVATE_DB_HOSTS=true
